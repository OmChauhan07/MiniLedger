// Purpose: Prisma schema definition for MiniLedger database models (User, Loan, OtpChallenge).
// Imported by: Prisma CLI and generated @prisma/client

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  loans     Loan[]
}

enum LoanType {
  LENT
  BORROWED
}

model Loan {
  id         String    @id @default(cuid())
  userId     String
  friendName String
  amount     Decimal   @db.Decimal(12, 2)
  dueDate    DateTime  @db.Date
  type       LoanType  @default(LENT)
  isRepaid   Boolean   @default(false)
  repaidAt   DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, isRepaid])
  @@index([userId, type, isRepaid])
}

model OtpChallenge {
  id           String    @id @default(cuid())
  phone        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone, expiresAt])
}
