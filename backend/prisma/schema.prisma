// Purpose: Prisma schema definition for MiniLedger database models (User, Loan, OtpChallenge).
// Imported by: Prisma CLI and generated @prisma/client

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  name              String?
  email             String?
  passwordHash      String?
  phoneVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  loans             Loan[]    @relation("UserLoans")
  counterpartyLoans Loan[]    @relation("CounterpartyLoans")

  @@index([phone])
  @@index([name])
}

enum LoanType {
  LENT
  BORROWED
}

model Loan {
  id                 String    @id @default(cuid())
  userId             String
  friendName         String
  amount             Decimal   @db.Decimal(12, 2)
  dueDate            DateTime  @db.Date
  type               LoanType  @default(LENT)
  isRepaid           Boolean   @default(false)
  repaidAt           DateTime?
  counterpartyUserId String?
  counterpartyPhone  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  user               User      @relation("UserLoans", fields: [userId], references: [id], onDelete: Cascade)
  counterpartyUser   User?     @relation("CounterpartyLoans", fields: [counterpartyUserId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([userId, isRepaid])
  @@index([userId, type, isRepaid])
  @@index([userId, counterpartyUserId])
}

model OtpChallenge {
  id           String    @id @default(cuid())
  phone        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone, expiresAt])
}
