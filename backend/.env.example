# MiniLedger Backend Environment Configuration
# Copy this file to .env and adjust values for local development. Never commit .env to version control.

# Server Port (default: 4000)
PORT=4000

# Node Environment (development | test | production)
NODE_ENV=development

# Database and Authentication placeholders (required starting in Phase 1)
# DATABASE_URL="postgresql://user:password@localhost:5432/miniledger?schema=public"
# JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
