# MiniLedger Backend Environment Configuration
# Copy this file to .env and adjust values for local development. Never commit .env to version control.

# Server Port (default: 4000)
PORT=4000

# Node Environment (development | test | production)
NODE_ENV=development

# Database Connection String
# Option 1: Neon PostgreSQL (pooled & unpooled connections)
# DATABASE_URL="postgresql://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# Option 2: Local PostgreSQL
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/miniledger?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:your_password@localhost:5432/miniledger?schema=public"

# JWT Secret Key (min 32 characters for security) and expiration
JWT_SECRET="dev-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID="your-neon-storage-access-key-id"
AWS_SECRET_ACCESS_KEY="your-neon-storage-secret-access-key"
AWS_ENDPOINT_URL_S3="https://<branch>.storage.<region>.aws.neon.tech"
AWS_REGION="us-east-1"
NEON_STORAGE_BUCKET="assets"
