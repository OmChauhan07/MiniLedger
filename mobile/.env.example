# MiniLedger Mobile Environment Configuration
# Copy this file to .env or .env.local for local overrides. Never commit secrets to version control.

# Backend API Endpoint Base URL (Default backend port: 4000)

# Option 1: Physical Android/iOS phone over local Wi-Fi (recommended for physical phone testing)
# Replace with your computer's local IPv4 address found by running `ipconfig` (Windows) or `ifconfig` (macOS/Linux):
# EXPO_PUBLIC_API_URL="http://192.168.1.xxx:4000/api"

# Option 2: Android Emulator running on the same machine (uses 10.0.2.2 alias for host localhost):
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api"

# Option 3: iOS Simulator or Web running on the same machine:
# EXPO_PUBLIC_API_URL="http://localhost:4000/api"
