# MiniLedger Mobile Environment Configuration
# Copy this file to .env.local for local overrides. Never commit secrets to version control.

# Backend API Endpoint Base URL (Must use HTTPS in production builds)
# Production example:
# EXPO_PUBLIC_API_URL="https://miniledger-api-14ch.onrender.com"

# Development local LAN host override (optional, for physical phone Wi-Fi testing)
# EXPO_PUBLIC_DEV_HOST="http://10.246.135.16:4000/api"
